PORT=8787
# Recommended production: TiDB Cloud connection string over TLS.
DATABASE_URL=mysql://user:password@localhost:3306/book_app
JWT_SECRET=replace-with-a-long-random-secret
STORAGE_ROOT=./storage
MAX_UPLOAD_MB=100
APPLE_SHARED_SECRET=
APPLE_ISSUER_ID=
APPLE_KEY_ID=
APPLE_PRIVATE_KEY=
APPLE_ROOT_CA_CERT=
GOOGLE_PLAY_SERVICE_ACCOUNT_JSON=
GOOGLE_PLAY_PACKAGE_NAME=com.manus.flutterbookapp
GOOGLE_PUBSUB_VERIFICATION_TOKEN=
APPLE_BUNDLE_ID=com.manus.flutterbookapp
ANDROID_PACKAGE_NAME=com.manus.flutterbookapp
BILLING_VERIFY_MODE=production
DEMO_MODE=false
CORS_ORIGINS=https://your-app-domain.example
PRIVACY_URL=https://your-app-domain.example/privacy
TERMS_URL=https://your-app-domain.example/terms
SUPPORT_EMAIL=support@your-app-domain.example
COPYRIGHT_EMAIL=copyright@your-app-domain.example
DB_POOL_SIZE=5
STORAGE_PROVIDER=s3
STORAGE_BUCKET=book-app-production
STORAGE_REGION=auto
STORAGE_ENDPOINT=
STORAGE_ACCESS_KEY_ID=
STORAGE_SECRET_ACCESS_KEY=
STORAGE_FORCE_PATH_STYLE=false
DATABASE_REQUIRED=false
AUTH_PROVIDER=oidc
# Recommended production: Auth0 tenant issuer and Book App API audience.
OIDC_ISSUER_URL=https://YOUR_AUTH0_DOMAIN/
OIDC_AUDIENCE=https://book-app-api
OIDC_ADMIN_CLAIM=roles
OIDC_ADMIN_VALUES=admin
ALLOW_LOCAL_STORAGE=false
API_RATE_LIMIT_MAX=120
API_RATE_LIMIT_WINDOW_SECONDS=60
AUTH_RATE_LIMIT_MAX=20
AUTH_RATE_LIMIT_WINDOW_SECONDS=600
